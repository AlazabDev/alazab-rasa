[Unit]
Description=AzaBot — Rasa Actions Server
Documentation=https://rasa.com/docs/rasa-sdk/
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=azab
Group=azab
WorkingDirectory=/opt/azabot

# تحميل متغيرات البيئة
EnvironmentFile=/opt/azabot/.env

# تفعيل venv تلقائياً
ExecStart=/opt/azabot/.venv/bin/python -m rasa_sdk \
    --actions actions \
    --port 5055

# إعادة التشغيل عند الفشل
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Logging
StandardOutput=append:/opt/azabot/logs/actions.out.log
StandardError=append:/opt/azabot/logs/actions.err.log

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
