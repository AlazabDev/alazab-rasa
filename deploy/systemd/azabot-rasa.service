[Unit]
Description=AzaBot — Rasa Pro CALM Server
Documentation=https://rasa.com/docs/rasa-pro/
After=network.target azabot-actions.service redis.service
Requires=azabot-actions.service
Wants=redis.service

[Service]
Type=simple
User=azab
Group=azab
WorkingDirectory=/opt/azabot

# تحميل متغيرات البيئة
EnvironmentFile=/opt/azabot/.env

# تفعيل venv — تشغيل Rasa
ExecStart=/opt/azabot/.venv/bin/rasa run \
    --enable-api \
    --cors "*" \
    --port 5005 \
    --endpoints .runtime/endpoints.generated.yml

# انتظر حتى actions server جاهز
ExecStartPre=/bin/bash -c 'for i in $(seq 1 15); do curl -fsS http://127.0.0.1:5055/health > /dev/null 2>&1 && break; echo "Waiting for actions..."; sleep 2; done'

# إعادة التشغيل
Restart=always
RestartSec=15
StartLimitInterval=300
StartLimitBurst=3

# Logging
StandardOutput=append:/opt/azabot/logs/rasa.out.log
StandardError=append:/opt/azabot/logs/rasa.err.log

# Timeout — Rasa يحتاج وقت للتحميل
TimeoutStartSec=180

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
