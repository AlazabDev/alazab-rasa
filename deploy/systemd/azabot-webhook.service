[Unit]
Description=AzaBot — FastAPI Webhook Server
Documentation=https://fastapi.tiangolo.com/
After=network.target azabot-rasa.service postgresql.service redis.service
Wants=azabot-rasa.service postgresql.service redis.service

[Service]
Type=simple
User=azab
Group=azab
WorkingDirectory=/opt/azabot

# تحميل متغيرات البيئة
EnvironmentFile=/opt/azabot/.env

# تفعيل venv — تشغيل Uvicorn
ExecStart=/opt/azabot/.venv/bin/uvicorn webhook.server:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --access-log \
    --no-server-header

# إعادة التشغيل عند الفشل
Restart=always
RestartSec=5
StartLimitInterval=120
StartLimitBurst=5

# Logging
StandardOutput=append:/opt/azabot/logs/webhook.out.log
StandardError=append:/opt/azabot/logs/webhook.err.log

# Security — أقوى من actions/rasa لأنه يستقبل طلبات خارجية
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/azabot/logs /opt/azabot/.runtime /opt/azabot/webhook/static/uploads
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
