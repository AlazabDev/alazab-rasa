[Unit]
Description=AzaBot — FastAPI Webhook Server
Documentation=https://fastapi.tiangolo.com/
After=network.target azabot-rasa.service 
Wants=azabot-rasa.service 

[Service]
Type=simple
User=azureuser
Group=azab
WorkingDirectory=/mnt/apps/alazab-rasa

# تحميل متغيرات البيئة
EnvironmentFile=/mnt/apps/alazab-rasa/.env

# تفعيل venv — تشغيل Uvicorn
ExecStart=/mnt/apps/alazab-rasa/.venv/bin/uvicorn webhook.server:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --access-log \
    --no-server-header

# إعادة التشغيل عند الفشل
Restart=always
RestartSec=5
StartLimitInterval=120
StartLimitBurst=5

# Logging
StandardOutput=append:/mnt/apps/alazab-rasa/logs/webhook.out.log
StandardError=append:/mnt/apps/alazab-rasa/logs/webhook.err.log

# Security — أقوى من actions/rasa لأنه يستقبل طلبات خارجية
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/mnt/apps/alazab-rasa/logs /mnt/apps/alazab-rasa/.runtime /mnt/apps/alazab-rasa/webhook/static/uploads
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
