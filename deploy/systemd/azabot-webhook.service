[Unit]
Description=AzaBot — FastAPI Webhook Server v4.1
After=network.target redis.service azabot-rasa.service
Wants=redis.service azabot-rasa.service

[Service]
Type=simple
User=azab
Group=azab
WorkingDirectory=/opt/azabot
EnvironmentFile=/opt/azabot/.env
ExecStart=/opt/azabot/.venv/bin/uvicorn webhook.server:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --no-server-header \
    --timeout-keep-alive 30
Restart=always
RestartSec=5
StartLimitInterval=120
StartLimitBurst=5
StandardOutput=append:/opt/azabot/logs/webhook.out.log
StandardError=append:/opt/azabot/logs/webhook.err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/azabot/logs /opt/azabot/.runtime /opt/azabot/webhook/static/uploads

[Install]
WantedBy=multi-user.target
