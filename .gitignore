# ══════════════════════════════════════════════════════════════
#  .gitignore — AzaBot / Alazab-Rasa
# ══════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python

# ── Rasa ──────────────────────────────────────────────────────
models/
results/
.rasa/
.runtime/

# ── Secrets & Credentials ─────────────────────────────────────
# ⛔ NEVER COMMIT THESE
.env
.env.*
!.env.example
!.env.nodocker.example
azabot/.env
*.pem
*.key
*.p12
gcp-*.json
service-account*.json
RASA_LICENSE1
RASA_LICENSE2
RASA_LICENSE3

# Session & runtime data
.runtime/sessions.json
.runtime/admin-data.json
.runtime/pids/
.runtime/admin-data.json

# ── Logs & Temp ───────────────────────────────────────────────
logs/
*.log
*.pid
*.tmp
*.bak
*.swp
*.orig

# ── Frontend ──────────────────────────────────────────────────
azabot/node_modules/
azabot/dist/
azabot/.pnpm-store/
azabot/tsconfig.*.tsbuildinfo
azabot/supabase/.temp/

# ── Uploads ───────────────────────────────────────────────────
webhook/static/uploads/

# ── Piper (large binary files) ────────────────────────────────
# Models ONNX — تحميل من HuggingFace
piper/*.onnx
piper/voice/models/
# Audio recordings — توليد بـ generate_brand_samples.py
piper/voice/audio/
# Cache
piper/__pycache__/
# Windows artifacts
*Zone.Identifier
*:Zone.Identifier

# ── SSL (never commit real certs) ─────────────────────────────
ssl/fullchain.pem
ssl/privkey.pem
ssl/*.pem

# ── Scratch / Dev ─────────────────────────────────────────────
scratch/
reports/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.iml
