# ══════════════════════════════════════════════════════════════
# AzaBot v4.0 — Production .env
# السيرفر: azureuser@azab-orchestrator | /mnt/apps/alazab-rasa
# تاريخ: مايو 2026
# ══════════════════════════════════════════════════════════════

# ── Rasa Pro License (expires 2029-04-12 | info@al-azab.co) ──
RASA_PRO_LICENSE=REPLACE_ME
RASA_URL=http://127.0.0.1:5005
ACTION_SERVER_URL=http://127.0.0.1:5055/webhook
RASA_REQUEST_TIMEOUT=30

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_ME
OPENAI_ORG_ID=REPLACE_ME
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDIO_TTS_MODEL=gpt-4o-mini-tts
AUDIO_TTS_VOICE=nova
OPENAI_HANDOFF_MODEL=gpt-4o-mini

# ── Admin Dashboard ───────────────────────────────────────────
ADMIN_EMAIL=manager@alazab.com
ADMIN_PASSWORD=REPLACE_ME
ADMIN_SESSION_SECRET=REPLACE_ME
ADMIN_API_KEY=REPLACE_ME
ADMIN_SESSION_TTL_SECONDS=604800

# ── Database (Supabase PostgreSQL) ───────────────────────────
DB_HOST=REPLACE_ME
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
SUPABASE_DB_PASSWORD=REPLACE_ME

# ── Supabase Cloud ────────────────────────────────────────────
SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_JWT_SECRET=REPLACE_ME
SUPABASE_PROJECT=REPLACE_ME
VITE_SUPABASE_URL=REPLACE_ME
VITE_SUPABASE_PROJECT_ID=REPLACE_ME
VITE_SUPABASE_ANON_KEY=REPLACE_ME
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME
REDIS_DB=0
REDIS_USE_SSL=false
REDIS_CLOUD_URL=REPLACE_ME

# ── WhatsApp Business API ─────────────────────────────────────
PHONE_NUMBER_ID=REPLACE_ME
WABA_ID=REPLACE_ME
META_API_VERSION=v18.0
WHATSAPP_API_URL=https://alazab.com/api/whatsapp
WHATSAPP_TOKEN=REPLACE_ME
NOTIFY_PHONE=REPLACE_ME

# ── Meta (Facebook + WhatsApp Webhooks) ──────────────────────
FB_APP_ID=REPLACE_ME
FB_APP_SECRET=REPLACE_ME
FB_PAGE_ACCESS_TOKEN=REPLACE_ME
FB_VERIFY_TOKEN=REPLACE_ME
META_TOKEN=REPLACE_ME

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_TOKEN=REPLACE_ME
TELEGRAM_BOT_NAME=REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME
NOTIFY_TG_CHAT_ID=REPLACE_ME

# ── UberFix / Maintenance Gateway ────────────────────────────
BOT_GATEWAY_URL=REPLACE_ME
BOT_API_KEY=REPLACE_ME
UBERFIX_API_URL=REPLACE_ME
UBERFIX_API_KEY=REPLACE_ME
MAINTENANCE_GATEWAY_URL=REPLACE_ME
MAINTENANCE_API_KEY=REPLACE_ME
MAINTENANCE_GATEWAY_URL_TRACK=https://uberfix.alazab.com/track

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# ── Public URLs ───────────────────────────────────────────────
PUBLIC_BASE_URL=https://chat.alazab.com
PUBLIC_IP=REPLACE_ME
ALLOWED_ORIGINS=https://alazab.com,https://www.alazab.com,https://brand-identity.alazab.com,https://laban-alasfour.alazab.com,https://luxury-finishing.alazab.com,https://uberfix.alazab.com,https://chat.alazab.com,https://bot.alazab.com

# ── Voice Services ────────────────────────────────────────────
DEEPGRAM_API_KEY=REPLACE_ME
CARTESIA_API_KEY=REPLACE_ME
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_AGENT_ID=REPLACE_ME

# ── Daftra ────────────────────────────────────────────────────
DAFTRA_SUBDOMAIN=alazab
DAFTRA_API_KEY=REPLACE_ME

# ── Deployment ────────────────────────────────────────────────
NODE_ENV=production
TRAIN_ON_DEPLOY=false
HOSTNAME=azab-server

# ── Rasa License Files ────────────────────────────────────────
RASA_LICENSE1_PATH=RASA_LICENSE1
RASA_LICENSE2_PATH=RASA_LICENSE2
RASA_LICENSE3_PATH=RASA_LICENSE3

