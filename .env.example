# ══════════════════════════════════════════════════════════════
# .env.example — AzaBot v4.1
# cp .env.example .env  ثم أكمل القيم الحقيقية
# توليد كلمات المرور:  python scripts/gen_password_hash.py
# ══════════════════════════════════════════════════════════════

# ── Rasa ──────────────────────────────────────────────────────
RASA_PRO_LICENSE=YOUR_RASA_PRO_LICENSE_JWT
RASA_URL=http://127.0.0.1:5005
ACTION_SERVER_URL=http://127.0.0.1:5055/webhook
RASA_REQUEST_TIMEOUT=30

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_ORG_ID=org-REPLACE_ME
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUDIO_TTS_MODEL=gpt-4o-mini-tts
AUDIO_TTS_VOICE=nova

# ── Admin — كلمة مرور مستقلة لكل مستخدم (bcrypt hash) ────────
# وِّلدها باستخدام:  python scripts/gen_password_hash.py
ADMIN_PASSWORD_HASH_ADMIN=$2b$12$REPLACE_WITH_BCRYPT_HASH
ADMIN_PASSWORD_HASH_DEVOPS=$2b$12$REPLACE_WITH_BCRYPT_HASH
ADMIN_PASSWORD_HASH_CEO=$2b$12$REPLACE_WITH_BCRYPT_HASH
ADMIN_PASSWORD_HASH_MOHAMED=$2b$12$REPLACE_WITH_BCRYPT_HASH

# سر الجلسات — شغّل: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
ADMIN_API_KEY=REPLACE_WITH_RANDOM_API_KEY
ADMIN_SESSION_TTL_SECONDS=604800

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_SECRET_KEY=REPLACE_ME
DB_HOST=YOUR_SUPABASE_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
SUPABASE_DB_PASSWORD=REPLACE_ME

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── WhatsApp Business ─────────────────────────────────────────
PHONE_NUMBER_ID=REPLACE_ME
META_API_VERSION=v18.0
WHATSAPP_TOKEN=REPLACE_ME
FB_APP_ID=REPLACE_ME
FB_APP_SECRET=REPLACE_ME
FB_PAGE_ACCESS_TOKEN=REPLACE_ME
FB_VERIFY_TOKEN=REPLACE_WITH_RANDOM_STRING

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_STRING
NOTIFY_TG_CHAT_ID=REPLACE_ME

# ── UberFix ───────────────────────────────────────────────────
UBERFIX_API_KEY=REPLACE_ME
BOT_API_KEY=REPLACE_ME

# ── Public ────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://bot.alazab.com
ALLOWED_ORIGINS=https://alazab.com,https://www.alazab.com,https://bot.alazab.com

# ── Misc ──────────────────────────────────────────────────────
DAFTRA_API_KEY=REPLACE_ME
NODE_ENV=production
TRAIN_ON_DEPLOY=false

# ── SSL (خارج الريبو دائماً) ──────────────────────────────────
# ssl/ مُضاف لـ .gitignore — ضع الشهادات في /etc/letsencrypt
