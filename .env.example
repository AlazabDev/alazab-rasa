# ══════════════════════════════════════════════════════════════
# AzaBot v4.0 — Environment Variables
# انسخ هذا الملف إلى .env وأضف قيمك
# ══════════════════════════════════════════════════════════════

# ── Rasa Pro ──────────────────────────────────────────────────
RASA_PRO_LICENSE=your-rasa-pro-license-key
RASA_URL=http://127.0.0.1:5005
RASA_REQUEST_TIMEOUT=30

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_HANDOFF_MODEL=gpt-4o-mini
GPT_MAX_CONCURRENT=5
GPT_TIMEOUT_SECONDS=30

# ── Admin Auth (داخلي — لا يحتاج أطراف خارجية) ──────────────
ADMIN_PASSWORD=Azab@202555
ADMIN_SESSION_SECRET=your-random-secret-min-32-chars
ADMIN_SESSION_TTL_SECONDS=604800
ADMIN_API_KEY=

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=azabot
DB_USER=azabot
DB_PASSWORD=your-db-password

# ── Redis (Rasa Tracker Store) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_LOCK_DB=1
REDIS_KEY_PREFIX=alazab

# ── WhatsApp Business API ─────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=your-whatsapp-bearer-token
NOTIFY_PHONE=201xxxxxxxxx
LEAD_RECEIVER_URL=

# ── Meta (WhatsApp + Messenger Webhooks) ─────────────────────
META_TOKEN=your-page-access-token
META_VERIFY=your-verify-token
META_SECRET=your-app-secret

# ── Telegram ──────────────────────────────────────────────────
TG_TOKEN=your-telegram-bot-token
TG_WEBHOOK_SECRET=your-random-secret

# ── UberFix Gateway ──────────────────────────────────────────
UBERFIX_BOT_GATEWAY_URL=https://your-uberfix-gateway/webhook
UBERFIX_API_KEY=your-uberfix-api-key
UBERFIX_TRACK_BASE_URL=https://uberfix.shop/track
MAINTENANCE_GATEWAY_URL=
MAINTENANCE_API_KEY=

# ── Daftra (فواتير) ───────────────────────────────────────────
DAFTRA_SUBDOMAIN=your-subdomain
DAFTRA_API_KEY=your-daftra-api-key

# ── Webhook Server ────────────────────────────────────────────
PUBLIC_BASE_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com
NODE_ENV=production
WEBHOOK_PORT=8000
WEBHOOK_WORKERS=2

# ── Uploads & Storage ─────────────────────────────────────────
UPLOADS_DIR=.runtime/uploads
MAX_UPLOAD_BYTES=10485760
ADMIN_DATA_FILE=.runtime/admin-data.json
ADMIN_SESSIONS_FILE=.runtime/sessions.json

# ── Audio (TTS + Transcription) ───────────────────────────────
AUDIO_TRANSCRIPTION_MODEL=whisper-1
AUDIO_TTS_MODEL=tts-1
AUDIO_TTS_VOICE=alloy

# ── Default Brand ─────────────────────────────────────────────
DEFAULT_BRAND=alazab_construction
